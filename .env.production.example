APP_ENV=production
PUBLIC_BASE_URL=https://api.friendminton.com
DOMAIN=api.friendminton.com
ACME_EMAIL=you@example.com

POSTGRES_DB=friendminton
POSTGRES_USER=friendminton
POSTGRES_PASSWORD=replace-with-a-long-random-password

DATABASE_URL=postgres://friendminton:replace-with-a-long-random-password@postgres:5432/friendminton
SERVER_ADDR=0.0.0.0:3000
RUST_LOG=friendminton=info,tower_http=info

AWS_REGION=us-west-2
GOOGLE_PLACES_API_KEY=replace-with-a-production-google-places-key
S3_BUCKET=friendminton-media-production
BETTER_AUTH_SECRET=replace-with-a-different-long-random-production-secret
GOOGLE_OAUTH_CLIENT_ID=replace-with-the-google-web-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-the-google-web-client-secret
APPLE_CLIENT_ID=com.hcharlie1201.friendminton
APPLE_TEAM_ID=replace-with-the-apple-team-id
APPLE_KEY_ID=replace-with-the-sign-in-with-apple-key-id
APPLE_PRIVATE_KEY_BASE64=replace-with-base64-encoded-p8-key
MOBILE_AUTH_CALLBACK_URL=friendminton://auth/callback
EMAIL_PROVIDER=ses
SES_REGION=us-west-2
SES_FROM_NAME=Friendminton
SES_FROM_ADDRESS=no-reply@friendminton.com
SES_REPLY_TO_ADDRESS=
SES_CONFIGURATION_SET=friendminton-production-transactional
SES_AWS_ACCESS_KEY_ID=replace-with-the-production-ses-access-key-id
SES_AWS_SECRET_ACCESS_KEY=replace-with-the-production-ses-secret-access-key
SES_AWS_SESSION_TOKEN=
